<?xml version="1.0" encoding="utf-8"?>
<!-- Ключи серверов и настройки не уходят ни в облачную копию Google, ни при
     переносе на новый телефон: это доступ к VPN, его не должно быть у копий. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
